//! Interpolation-mode driving for the Roslyn C# lexer.
//!
//! Roslyn's grammar spells an interpolated string as
//! `'$"' interpolated_string_content* '"'` with `interpolation : '{' expression
//! … '}'`. The text between holes needs its own lexer mode, because in the
//! default mode a broad negated set would swallow ordinary code.
//!
//! The mode transitions cannot be grammar commands, because the `}` that closes
//! a hole is lexically identical to the one closing a nested block:
//!
//! ```text
//! $"a{ new[]{ 1, 2 }.Length }b"
//!            ^^^^^^^^^  must NOT end the hole
//! ```
//!
//! Telling them apart needs a brace depth per open hole and a *conditional*
//! pop, so this hook owns the whole state machine and the grammar carries no
//! mode commands at all.

use antlr4_runtime::{CharStream, LexerLifecycleCtx, SemanticHooks};

use crate::csharp_lexer as cl;

/// Lexer state for interpolated strings: one brace-depth counter per hole that
/// is currently open.
///
/// `holes` doubles as the "are we inside an interpolated string" flag — it is
/// empty exactly when no hole is open.
#[derive(Clone, Debug, Default)]
pub struct CSharpLexerHooks {
    holes: Vec<u32>,
}

impl SemanticHooks for CSharpLexerHooks {
    fn lexer_after_accept<I>(&mut self, ctx: &mut LexerLifecycleCtx<'_, I>)
    where
        I: CharStream,
    {
        // `set_type` has already run, so a hole's `{` and the closing `"` report
        // the *remapped* types. They are distinguished from ordinary braces and
        // quotes by the mode they were accepted in.
        let in_interpolation = ctx.mode() == cl::MODE_INTERPOLATION;
        let token_type = ctx.token_type();

        if token_type == cl::INTERP_START || token_type == cl::INTERP_VERBATIM_START {
            // Entering an interpolated string: its text lexes in INTERPOLATION.
            ctx.push_mode(cl::MODE_INTERPOLATION);
            return;
        }

        if in_interpolation {
            if token_type == cl::OP_181 {
                // A hole opened. Its expression is ordinary C#, so drop back to
                // the default mode and start counting braces for this hole.
                self.holes.push(0);
                ctx.push_mode(cl::MODE_DEFAULT_MODE);
            } else if token_type == cl::OP_158 {
                // The interpolated string ended.
                ctx.pop_mode();
            }
            return;
        }

        // A format specifier's text was accepted in INTERPOLATION_FORMAT; its
        // closing `}` ends the hole, so unwind both that mode and the hole.
        if ctx.mode() == cl::MODE_INTERPOLATION_FORMAT {
            if token_type == cl::OP_183 {
                self.holes.pop();
                ctx.pop_mode(); // leave INTERPOLATION_FORMAT
                ctx.pop_mode(); // leave the hole's DEFAULT_MODE
            }
            return;
        }

        // Inside a hole's expression (default mode) we track braces, and watch
        // for the `:` that starts a format specifier.
        let Some(depth) = self.holes.last_mut() else {
            return;
        };
        if token_type == cl::OP_181 {
            *depth += 1;
        } else if token_type == cl::OP_183 {
            if *depth == 0 {
                // This `}` closes the hole: back to interpolation text.
                self.holes.pop();
                ctx.pop_mode();
            } else {
                *depth -= 1;
            }
        } else if token_type == cl::OP_171 && *depth == 0 {
            // `{x:D4}` — the rest of the hole is literal format text. A `:` at
            // any deeper brace depth belongs to a nested construct (a ternary,
            // a dictionary initializer, a label) and is not a format clause.
            ctx.push_mode(cl::MODE_INTERPOLATION_FORMAT);
        }
    }

    fn lexer_reset<I>(&mut self, _ctx: &mut LexerLifecycleCtx<'_, I>)
    where
        I: CharStream,
    {
        self.holes.clear();
    }
}
